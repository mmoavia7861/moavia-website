rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // The verified password-authenticated owner is the only administrator.
    function owner() {
      return verified() &&
        request.auth.token.email == 'moavia400@gmail.com' &&
        request.auth.token.firebase.sign_in_provider == 'password';
    }

    function admin() {
      return owner();
    }

    function leadManager() {
      return owner();
    }

    function editor() {
      return owner();
    }

    function validLead() {
      return request.resource.data.keys().hasOnly([
        'fullName', 'email', 'whatsapp', 'businessName', 'websiteUrl',
        'service', 'budget', 'description', 'status', 'assignedManager',
        'createdAt', 'updatedAt'
      ]) &&
      request.resource.data.keys().hasAll([
        'fullName', 'email', 'whatsapp', 'businessName', 'websiteUrl',
        'service', 'budget', 'description', 'status', 'assignedManager',
        'createdAt', 'updatedAt'
      ]) &&
      request.resource.data.fullName is string &&
      request.resource.data.fullName.size() > 0 &&
      request.resource.data.fullName.size() <= 120 &&
      request.resource.data.email is string &&
      request.resource.data.email.size() > 5 &&
      request.resource.data.email.size() <= 254 &&
      request.resource.data.whatsapp is string &&
      request.resource.data.whatsapp.size() <= 40 &&
      request.resource.data.businessName is string &&
      request.resource.data.businessName.size() <= 200 &&
      request.resource.data.websiteUrl is string &&
      request.resource.data.websiteUrl.size() <= 300 &&
      request.resource.data['service'] is string &&
      request.resource.data['service'].size() > 0 &&
      request.resource.data['service'].size() <= 160 &&
      request.resource.data.budget is string &&
      request.resource.data.budget.size() <= 100 &&
      request.resource.data.description is string &&
      request.resource.data.description.size() <= 3000 &&
      request.resource.data.status == 'New' &&
      request.resource.data.assignedManager == 'Moavia Hassan' &&
      request.resource.data.createdAt is string &&
      request.resource.data.updatedAt is string;
    }

    function validNewsletterSignup() {
      return request.resource.data.keys().hasOnly([
        'email', 'status', 'source', 'consent', 'createdAt'
      ]) &&
      request.resource.data.keys().hasAll([
        'email', 'status', 'source', 'consent', 'createdAt'
      ]) &&
      request.resource.data.email is string &&
      request.resource.data.email.size() > 5 &&
      request.resource.data.email.size() <= 254 &&
      request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$') &&
      request.resource.data.status == 'active' &&
      request.resource.data.source == 'footer_signup' &&
      request.resource.data.consent == true &&
      request.resource.data.createdAt == request.time;
    }

    // CMS documents can only be changed by the verified owner.
    function validCms(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['slug','title','excerpt','body','category',
        'imageUrl','linkUrl','repoUrl','metaTitle','metaDescription',
        'published','createdAt','updatedAt']) &&
        d.keys().hasAll(['slug','title','excerpt','body','category',
        'imageUrl','linkUrl','repoUrl','metaTitle','metaDescription',
        'published','createdAt','updatedAt']) &&
        id.matches('^[a-z0-9]+(-[a-z0-9]+)*
    match /adminUsers/{uid} {
      allow read, write: if false;
    }

    match /adminEmailRegistry/{entry} {
      allow read, write: if false;
    }

    match /adminInvitations/{entry} {
      allow read, write: if false;
    }

    match /newsletterSubscribers/{subscriberId} {
      // Anonymous visitors can subscribe, but cannot read the list or overwrite.
      // Document IDs are SHA-256 digests of normalized email in the frontend.
      allow create: if validNewsletterSignup() &&
        subscriberId.matches('^[0-9a-f]{64}$');
      allow read, update, delete: if owner();
    }

    match /leads/{id} {
      // New inquiries use a 64-character SHA-256 email digest as their ID.
      // Create-only writes prevent the same normalized email being saved twice
      // through the public form. Old records remain readable by the owner.
      // This format check cannot independently prove the hash matches email;
      // preventing malicious bypasses requires server-side verification.
      allow create: if validLead() &&
        id.matches('^[0-9a-f]{64}$');
      allow read: if admin();
      allow update, delete: if leadManager();
    }

    match /clients/{id} {
      allow read, write: if leadManager();
    }

    match /projects/{id} {
      allow read, write: if leadManager();
    }

    match /portfolioProjects/{id} {
      allow read: if owner() || resource.data.published == true;
      allow create, update: if owner() && validCms(id);
      allow delete: if owner();
    }

    match /blogPosts/{id} {
      allow read: if owner() || resource.data.published == true;
      allow create, update: if owner() && validCms(id);
      allow delete: if owner();
    }

    match /cmsServices/{id} {
      allow read: if owner() || resource.data.published == true;
      allow create, update: if owner() && validCms(id);
      allow delete: if owner();
    }

    match /cmsPages/{id} {
      allow read: if owner() || resource.data.published == true;
      allow create, update: if owner() && validCms(id);
      allow delete: if owner();
    }

    match /siteSettings/{id} {
      allow read: if id == 'public' || owner();
      allow write: if owner();
    }

    match /auditLogs/{id} {
      allow read: if owner();
      allow write: if false;
    }
  }
}
) &&
        d.slug == id &&
        d.title is string && d.title.size() > 0 && d.title.size() <= 140 &&
        d.excerpt is string && d.excerpt.size() > 0 && d.excerpt.size() <= 320 &&
        d.body is string && d.body.size() > 0 && d.body.size() <= 16000 &&
        d.category is string && d.category.size() <= 80 &&
        d.imageUrl is string && d.imageUrl.size() <= 500 &&
        d.linkUrl is string && d.linkUrl.size() <= 500 &&
        d.repoUrl is string && d.repoUrl.size() <= 500 &&
        d.metaTitle is string && d.metaTitle.size() <= 160 &&
        d.metaDescription is string && d.metaDescription.size() <= 320 &&
        d.published is bool &&
        d.createdAt is string && d.createdAt.size() <= 40 &&
        d.updatedAt is string && d.updatedAt.size() <= 40;
    }

    // Any path not specifically granted below remains denied by default.
    match /adminUsers/{uid} {
      allow read, write: if false;
    }

    match /adminEmailRegistry/{entry} {
      allow read, write: if false;
    }

    match /adminInvitations/{entry} {
      allow read, write: if false;
    }

    match /newsletterSubscribers/{subscriberId} {
      // Anonymous visitors can subscribe, but cannot read the list or overwrite.
      // Document IDs are SHA-256 digests of normalized email in the frontend.
      allow create: if validNewsletterSignup() &&
        subscriberId.matches('^[0-9a-f]{64}$');
      allow read, update, delete: if owner();
    }

    match /leads/{id} {
      // New inquiries use a 64-character SHA-256 email digest as their ID.
      // Create-only writes prevent the same normalized email being saved twice
      // through the public form. Old records remain readable by the owner.
      // This format check cannot independently prove the hash matches email;
      // preventing malicious bypasses requires server-side verification.
      allow create: if validLead() &&
        id.matches('^[0-9a-f]{64}$');
      allow read: if admin();
      allow update, delete: if leadManager();
    }

    match /clients/{id} {
      allow read, write: if leadManager();
    }

    match /projects/{id} {
      allow read, write: if leadManager();
    }

    match /portfolioProjects/{id} {
      allow read: if resource.data.published == true || admin();
      allow create, update, delete: if editor();
    }

    match /blogPosts/{id} {
      allow read: if resource.data.published == true || admin();
      allow create, update, delete: if editor();
    }

    match /cmsServices/{id} {
      allow read: if owner() || resource.data.published == true;
      allow create, update, delete: if owner();
    }

    match /cmsPages/{id} {
      allow read: if owner() || resource.data.published == true;
      allow create, update, delete: if owner();
    }

    match /siteSettings/{id} {
      allow read: if id == 'public' || owner();
      allow write: if owner();
    }

    match /auditLogs/{id} {
      allow read: if owner();
      allow write: if false;
    }
  }
}
