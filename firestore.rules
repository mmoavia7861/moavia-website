rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function owner() {
      return verified() &&
        request.auth.token.email == 'moaviahassan124@gmail.com';
    }
    function approvedStaff() {
      return verified() &&
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.email == request.auth.token.email &&
        get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role in ['Manager', 'Content Editor', 'Viewer'];
    }
    function admin() {
      return owner() || approvedStaff();
    }
    function canManageLeads() {
      return owner() || (approvedStaff() && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role == 'Manager');
    }
    function validLead() {
      return request.resource.data.keys().hasOnly([
        'fullName','email','whatsapp','businessName','websiteUrl','service',
        'budget','description','status','assignedManager','createdAt','updatedAt'
      ]) &&
      request.resource.data.fullName is string && request.resource.data.fullName.size() > 0 && request.resource.data.fullName.size() <= 120 &&
      request.resource.data.email is string && request.resource.data.email.size() <= 254 &&
      request.resource.data.service is string && request.resource.data.service.size() <= 160 &&
      request.resource.data.description is string && request.resource.data.description.size() <= 3000 &&
      request.resource.data.status == 'New' &&
      request.resource.data.assignedManager == 'Moavia Hassan';
    }
    match /{anyPath=**} { allow read, write: if false; }
    match /adminUsers/{uid} {
      allow read: if owner() || (verified() && request.auth.uid == uid);
      allow write: if owner();
    }
    match /adminEmailRegistry/{entry} { allow read, write: if false; }
    match /adminInvitations/{entry} { allow read, write: if false; }
    match /leads/{id} {
      allow create: if validLead();
      allow read: if admin();
      allow update, delete: if canManageLeads();
    }
    match /clients/{id} { allow read, write: if canManageLeads(); }
    match /projects/{id} { allow read, write: if canManageLeads(); }
    match /portfolioProjects/{id} {
      allow get, list: if (resource.data.published == true) || admin();
      allow create, update, delete: if owner() || (approvedStaff() && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role == 'Content Editor');
    }
    match /blogPosts/{id} {
      allow get, list: if (resource.data.published == true) || admin();
      allow create, update, delete: if owner() || (approvedStaff() && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role == 'Content Editor');
    }
    match /siteSettings/{id} {
      allow read: if true;
      allow write: if owner();
    }
    match /auditLogs/{id} {
      allow read: if owner();
      allow write: if false;
    }
  }
}
