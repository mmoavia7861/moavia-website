{
  "name": "moaviaseo",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "ratelimits": [
    {
      "name": "AI_LIMITER",
      "namespace_id": "819471",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
