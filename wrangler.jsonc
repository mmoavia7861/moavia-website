{
  "name": "moaviaseo",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/api/*",
      "/",
      "/blog/*",
      "/projects/*",
      "/offerings/*",
      "/pages/*",
      "/sitemap.xml",
      "/about/*",
      "/contact/*",
      "/hire-me/*",
      "/tools",
      "/tools/*"
    ],
    "not_found_handling": "404-page"
  }
}
